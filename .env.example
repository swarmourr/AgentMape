# ── Service ──────────────────────────────────────────────────────────────────
SERVICE_NAME=pegasus-remediation
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use SQLite (no server needed).
# Set to postgresql+asyncpg:// for production multi-node deployments.
DATABASE_URL=
SQLITE_PATH=checkpoints.db

# ── AMQP / RabbitMQ ──────────────────────────────────────────────────────────
# Disabled by default — POST script path works without it.
# Set AMQP_ENABLED=true when consuming Pegasus Stampede monitoring events.
AMQP_ENABLED=false
AMQP_URL=amqp://pegasus:pegasus_secret@localhost:5672/pegasus

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM — pick any provider supported by LiteLLM ────────────────────────────
#
# Cloud providers (require API key):
#   OpenAI          LLM_MODEL=gpt-4o               LLM_API_KEY=sk-...
#   Anthropic       LLM_MODEL=anthropic/claude-opus-4-6   LLM_API_KEY=sk-ant-...
#   Azure OpenAI    LLM_MODEL=azure/gpt-4o          LLM_API_KEY=...  LLM_BASE_URL=https://...
#   AWS Bedrock     LLM_MODEL=bedrock/anthropic.claude-3-opus  (uses AWS env vars below)
#
# Local Ollama (no API key needed):
#   Install:  https://ollama.com
#   Pull:     ollama pull llama3.3      # 70B, best accuracy
#             ollama pull qwen2.5:72b   # good alternative
#   Set:      LLM_MODEL=ollama/llama3.3
#             LLM_BASE_URL=http://localhost:11434   # optional, this is the default
#   Note:     JSON structured-output mode is auto-selected for Ollama models.
#             Cloud providers use TOOLS mode (function calling).
#
# Any OpenAI-compatible endpoint:
#   LLM_MODEL=openai/my-model          LLM_BASE_URL=http://your-endpoint/v1
#
LLM_MODEL=ollama/qwen2.5:latest
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434

# Provider-specific keys (LiteLLM reads these automatically by model prefix)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=

# ── Policy ────────────────────────────────────────────────────────────────────
POLICY_FILE=policies/remediation.yaml
CONFIDENCE_THRESHOLD=0.80

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# OTLP_ENDPOINT=http://localhost:4317
