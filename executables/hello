#!/bin/bash
# hello — first stage of the hello-world workflow
# Usage: hello -T <sleep_secs> -i <input_file> -o <output_file>

set -euo pipefail

SLEEP=0
INPUT=""
OUTPUT=""

while getopts "T:i:o:" opt; do
    case "$opt" in
        T) SLEEP="$OPTARG" ;;
        i) INPUT="$OPTARG" ;;
        o) OUTPUT="$OPTARG" ;;
        *) echo "Usage: hello -T secs -i input -o output" >&2; exit 1 ;;
    esac
done

[ -z "$INPUT"  ] && { echo "hello: missing -i input"  >&2; exit 1; }
[ -z "$OUTPUT" ] && { echo "hello: missing -o output" >&2; exit 1; }
[ ! -f "$INPUT" ] && { echo "hello: input file not found: $INPUT" >&2; exit 1; }

# --- Simulate OOM on first attempt ------------------------------------------
# Use INPUT dir for the marker — it persists across DAGMan retries unlike
# the job's scratch/output directory which may be cleaned between retries.
MARKER="${INPUT}.attempts"
ATTEMPT=$(cat "$MARKER" 2>/dev/null || echo 0)
echo $((ATTEMPT + 1)) > "$MARKER"

if [ "$ATTEMPT" -lt 1 ]; then
    echo "MemoryError: job exceeded memory limit — killed by signal 9" >&2
    echo "Memory usage exceeded RequestMemory (1 MB)" >&2
    exit 137   # 128 + SIGKILL(9) — real Linux OOM kill code
fi
# ----------------------------------------------------------------------------

sleep "$SLEEP"

{
    echo "=== hello stage ==="
    cat "$INPUT"
    echo "Processed by: hello"
    echo "Timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$OUTPUT"

echo "hello: wrote $OUTPUT"
